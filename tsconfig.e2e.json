{
  "compilerOptions": {
    "tsBuildInfoFile": "./node_modules/.tmp/tsconfig.e2e.tsbuildinfo",
    "target": "ESNext",
    "lib": [
      "ES2023",
      "DOM"
    ],
    "module": "ESNext",
    /* Playwright's runner is Node-based, so these files get Node + Playwright
       globals — never `@types/bun`. Both packages declare `expect`/`test`, and
       a project that pulls in both resolves them to conflicting signatures. */
    "types": [
      "@playwright/test",
      "@types/node"
    ],
    "skipLibCheck": true,
    /* Bundler mode */
    "moduleResolution": "bundler",
    "allowImportingTsExtensions": true,
    "verbatimModuleSyntax": true,
    "moduleDetection": "force",
    "noEmit": true,
    /* Linting */
    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "erasableSyntaxOnly": true,
    "noFallthroughCasesInSwitch": true,
    "noUncheckedSideEffectImports": true
  },
  "include": [
    "playwright.config.ts",
    "e2e/**/*.ts"
  ]
}
