# Local development - copy to .env.local
#
# Point these at a workspace you can reach — typically a real box's API and
# Casdoor, or a local workspace-api. There are no defaults: the Console is
# neutral until told where its workspace lives.

VITE_WORKSPACE_API_URL=
VITE_AUTH_URL=
# Casdoor's GENERATED client id for the workspace's `console` application, not
# the application name — the name is rejected at code exchange. A public PKCE
# client id, not a secret.
VITE_AUTH_CLIENT_ID=
VITE_AUTH_REDIRECT_URI=http://localhost:5173/callback
# The Casdoor organization that owns the workspace's users.
VITE_AUTH_ORGANIZATION=

# Error tracking (Sentry SDK envelope format). Deliberately unset for local
# development — an unset DSN disables the SDK, so your stack traces stay in
# your console. Set one only when you need to verify the integration itself.
#VITE_SENTRY_DSN=
